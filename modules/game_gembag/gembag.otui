GemBagSlot < UIItem
  size: 44 44
  padding: 6
  image-source: /images/game/wheel/backdrop_skillwheel_socket_inactive
  image-smooth: true
  image-color: #d0d0d0
  change-cursor-image: true
  cursor: pointer

  $hover:
    image-color: #ffffff

  $on:
    image-source: /images/game/wheel/backdrop_skillwheel_socket_active

  UIWidget
    id: activeGlow
    anchors.fill: parent
    margin: -8
    image-source: /images/game/wheel/marker_skillwheelsocket
    image-smooth: true
    image-color: #f0c06040
    phantom: true
    visible: false

  UIWidget
    id: activeRing
    anchors.fill: parent
    margin: -6
    image-source: /images/game/wheel/marker_skillwheelsocket
    image-smooth: true
    image-color: #f0c060d0
    phantom: true
    visible: false

GemEquipmentIcon < UIItem
  size: 34 34
  virtual: true
  phantom: true

GemGroupPanel < UIWidget
  height: 72
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000055
  padding: 6

  UIWidget
    id: equipmentFrame
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000088
    phantom: true

  Label
    id: groupTitle
    anchors.left: equipmentFrame.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: -2
    font: verdana-11px-rounded
    color: #f0c060
    text-auto-resize: true
    phantom: true

GemBagActionButton < Button
  width: 82
  height: 22
  font: Verdana Bold-11px
  color: #ffffff
  text-offset: 0 1

  $hover !disabled:
    color: #f0c060

GemBonusRow < UIWidget
  height: 18
  phantom: true

  UIWidget
    id: icon
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-smooth: true
    phantom: true

  Label
    id: caption
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true
    phantom: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    text-auto-resize: true
    phantom: true

GemSectionHeader < UIWidget
  height: 20
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000088
  padding-left: 6

  UIWidget
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/wheel/icon-socketed
    phantom: true

  Label
    id: title
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #f0c060
    text-auto-resize: true
    phantom: true

MainWindow
  id: gemBagWindow
  !text: tr('Bag Gem')
  size: 470 422
  @onEscape: modules.game_gembag.toggle()

  UIWidget
    id: helpIcon
    size: 11 11
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -6
    margin-right: -13
    image-source: /images/skin/show-gui-help-blue
    !tooltip: tr('- Equip gems to grant your character special attributes.\n- Right-click a socketed gem to remove it.')

  Panel
    id: slotsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    width: 222
    margin-bottom: 10

    GemGroupPanel
      id: helmetGroup
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

      GemEquipmentIcon
        id: helmetSlotIcon
        anchors.centerIn: equipmentFrame

      GemBagSlot
        id: gemSlot0
        anchors.left: equipmentFrame.right
        anchors.bottom: parent.bottom
        margin-left: 10
        margin-bottom: -2

      GemBagSlot
        id: gemSlot1
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

      GemBagSlot
        id: gemSlot2
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

    GemGroupPanel
      id: bodyGroup
      anchors.top: helmetGroup.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

      GemEquipmentIcon
        id: bodySlotIcon
        anchors.centerIn: equipmentFrame

      GemBagSlot
        id: gemSlot3
        anchors.left: equipmentFrame.right
        anchors.bottom: parent.bottom
        margin-left: 10
        margin-bottom: -2

      GemBagSlot
        id: gemSlot4
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

      GemBagSlot
        id: gemSlot5
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

    GemGroupPanel
      id: weaponGroup
      anchors.top: bodyGroup.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

      GemEquipmentIcon
        id: weaponSlotIcon
        anchors.centerIn: equipmentFrame

      GemBagSlot
        id: gemSlot6
        anchors.left: equipmentFrame.right
        anchors.bottom: parent.bottom
        margin-left: 10
        margin-bottom: -2

      GemBagSlot
        id: gemSlot7
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

      GemBagSlot
        id: gemSlot8
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

    GemGroupPanel
      id: legsGroup
      anchors.top: weaponGroup.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

      GemEquipmentIcon
        id: legsSlotIcon
        anchors.centerIn: equipmentFrame

      GemBagSlot
        id: gemSlot9
        anchors.left: equipmentFrame.right
        anchors.bottom: parent.bottom
        margin-left: 10
        margin-bottom: -2

      GemBagSlot
        id: gemSlot10
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

      GemBagSlot
        id: gemSlot11
        anchors.left: prev.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-bottom: -2

  UIWidget
    id: bonusPanel
    anchors.top: parent.top
    anchors.left: slotsPanel.right
    anchors.right: parent.right
    anchors.bottom: slotsPanel.bottom
    margin-left: 8
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000055
    padding: 6

    GemSectionHeader
      id: bonusHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    Panel
      id: bonusList
      anchors.top: bonusHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: socketedCountLabel.top
      margin-top: 8
      margin-left: 4
      margin-right: 4
      layout:
        type: verticalBox
        spacing: 4

    Label
      id: emptyBonusLabel
      anchors.top: bonusHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 30
      font: verdana-11px-rounded
      color: #707070
      text-align: center
      text-wrap: true
      text-auto-resize: true
      visible: false

    Label
      id: socketedCountLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: socketedProgress.top
      margin-bottom: 4
      margin-left: 2
      font: verdana-11px-rounded
      color: #9d9d9d

    ProgressBar
      id: socketedProgress
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 8
      background-color: #c28400
      on: true

  GemBagActionButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_gembag.toggle()

  Label
    id: hintLabel
    anchors.left: parent.left
    anchors.right: closeButton.left
    anchors.verticalCenter: closeButton.verticalCenter
    margin-right: 8
    font: verdana-11px-rounded
    color: #8a8a8a
    text-align: left
    !text: tr('Drag gems onto sockets. Right-click to remove.')
