BattlePassDay < UIWidget
  size: 90 70
  background-color: #18162a
  border-width: 1
  border-color: #2e2b4a
  focusable: false
  @onClick: modules.game_battlepass.onDayClicked(self)

  Label
    id: dayNumber
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    font: verdana-11px-antialised
    color: #8078a0
    text-align: center
    phantom: true

  UIItem
    id: item
    size: 28 28
    anchors.top: dayNumber.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    virtual: true
    phantom: true

  Label
    id: status
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8
    font: verdana-11px-antialised
    color: #585070
    text: Locked
    text-align: center
    phantom: true

  $current:
    border-width: 2
    border-color: #c28400
    background-color: #26200a

  $done:
    border-width: 2

BattlePassRewardItem < UIWidget
  size: 84 125
  focusable: false

  UIItem
    id: icon
    size: 36 36
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    virtual: true
    border-width: 1
    border-color: #2e2b4a

  Label
    id: qty
    anchors.top: icon.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    font: verdana-11px-antialised
    color: #a89cc0
    text-align: center
    text-auto-resize: true

  Label
    id: itemName
    anchors.top: qty.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    font: verdana-11px-antialised
    color: #6c6488
    text-align: center
    text-wrap: true
    text-auto-resize: false
    height: 72

MainWindow
  id: battlePassWindow
  size: 940 620
  @onEscape: modules.game_battlepass.hide()

  UIWidget
    id: titleBanner
    size: 240 80
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -65
    image-source: /images/custom/battle_pass
    image-auto-resize: true
    phantom: true

  Panel
    id: subHeader
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    background-color: #1c1930

    Label
      id: seasonLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      font: verdana-11px-antialised
      color: #e0b050
      text-auto-resize: true

    Label
      id: dayBadge
      anchors.right: dateLabel.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12
      font: verdana-11px-antialised
      color: #e0b050
      text-auto-resize: true

    Label
      id: dateLabel
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      font: verdana-11px-antialised
      color: #8078a0
      text-auto-resize: true

  Panel
    id: progressRow
    anchors.top: subHeader.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    margin-top: 4
    background-color: #1c1930

    Label
      id: progressLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      font: verdana-11px-antialised
      color: #8078a0
      text: PROGRESS:
      text-auto-resize: true

    ProgressBar
      id: progressBar
      anchors.left: progressLabel.right
      anchors.right: progressSideLabel.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      margin-right: 12
      height: 16
      background-color: #8a5a00

    Label
      id: progressSideLabel
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      margin-left: 12
      font: verdana-11px-antialised
      color: #8078a0
      text-auto-resize: true

  Panel
    id: leftPanel
    anchors.top: progressRow.bottom
    anchors.left: parent.left
    anchors.bottom: footerSeparator.top
    width: 460
    margin-top: 8
    margin-bottom: 12
    background-color: #18162a

    UIScrollArea
      id: dayScrollArea
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: dayScrollbar.left
      anchors.bottom: missionBar.top
      margin-right: 4
      vertical-scrollbar: dayScrollbar
      layout:
        type: grid
        cell-size: 90 70
        cell-spacing: 4
        flow: true

    VerticalScrollBar
      id: dayScrollbar
      width: 10
      anchors.top: dayScrollArea.top
      anchors.bottom: dayScrollArea.bottom
      anchors.right: parent.right
      step: 70
      pixels-scroll: true
      auto-hide: true

    Panel
      id: missionBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 80
      background-color: #1c1930
      border-top-width: 1
      border-color: #2e2b4a
      padding: 8

      Label
        id: missionSectionTitle
        anchors.top: parent.top
        anchors.left: parent.left
        font: verdana-11px-antialised
        color: #a090c0
        text: MISSION

      Label
        id: missionDayIndicator
        anchors.top: parent.top
        anchors.right: parent.right
        font: verdana-11px-antialised
        color: #6c6488
        text-auto-resize: true

      UIItem
        id: missionItem
        size: 32 32
        anchors.top: missionSectionTitle.bottom
        anchors.left: parent.left
        margin-top: 4
        virtual: true

      Label
        id: missionDesc
        anchors.top: missionSectionTitle.bottom
        anchors.left: missionItem.right
        anchors.right: parent.right
        margin-left: 8
        margin-top: 4
        font: verdana-11px-antialised
        color: #c0b8d8
        text-wrap: true
        text-auto-resize: true

      Label
        id: missionProgress
        anchors.top: missionItem.bottom
        anchors.left: parent.left
        margin-top: 4
        font: verdana-11px-antialised
        color: #507050

  Panel
    id: rightPanel
    anchors.top: progressRow.bottom
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: footerSeparator.top
    margin-top: 8
    margin-left: 8
    margin-right: 8
    margin-bottom: 12
    background-color: #18162a

    Panel
      id: detailHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28
      background-color: #1c1930
      border-bottom-width: 1
      border-color: #2e2b4a

      Label
        id: detailDayLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        font: verdana-11px-antialised
        color: #a090c0
        text-auto-resize: true

    Panel
      id: proRewardBlock
      anchors.top: detailHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 204
      margin-top: 8
      background-color: #1c1930
      border-left-width: 3
      border-color: #c28400

      Label
        id: proTrackLabel
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        font: verdana-11px-antialised
        color: #c28400
        text: PRO
        text-auto-resize: true

      UIScrollArea
        id: proRewardItems
        anchors.top: proTrackLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: proRewardScrollbar.top
        margin-top: 6
        margin-left: 8
        margin-right: 8
        margin-bottom: 6
        horizontal-scrollbar: proRewardScrollbar
        layout:
          type: horizontalBox
          spacing: 8

      HorizontalScrollBar
        id: proRewardScrollbar
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: proClaimButton.top
        margin-left: 8
        margin-right: 8
        margin-bottom: 8
        height: 6
        step: 44
        pixels-scroll: true
        auto-hide: true

      Button
        id: proClaimButton
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 8
        margin-right: 8
        margin-bottom: 8
        height: 22
        font: verdana-11px-antialised
        color: #c28400
        background-color: #2a1e00
        border-width: 1
        border-color: #6a4a00
        @onClick: modules.game_battlepass.claimProReward()

    Panel
      id: freeRewardBlock
      anchors.top: proRewardBlock.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 204
      margin-top: 8
      background-color: #1c1930
      border-left-width: 3
      border-color: #3a9a3a

      Label
        id: freeTrackLabel
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 8
        margin-left: 8
        font: verdana-11px-antialised
        color: #3a9a3a
        text: FREE
        text-auto-resize: true

      UIScrollArea
        id: freeRewardItems
        anchors.top: freeTrackLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: freeRewardScrollbar.top
        margin-top: 6
        margin-left: 8
        margin-right: 8
        margin-bottom: 6
        horizontal-scrollbar: freeRewardScrollbar
        layout:
          type: horizontalBox
          spacing: 8

      HorizontalScrollBar
        id: freeRewardScrollbar
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: freeClaimButton.top
        margin-left: 8
        margin-right: 8
        margin-bottom: 8
        height: 6
        step: 44
        pixels-scroll: true
        auto-hide: true

      Button
        id: freeClaimButton
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 8
        margin-right: 8
        margin-bottom: 8
        height: 22
        font: verdana-11px-antialised
        color: #3a9a3a
        background-color: #0a200a
        border-width: 1
        border-color: #1a5a1a
        @onClick: modules.game_battlepass.claimFreeReward()

    Button
      id: statusButton
      anchors.top: freeRewardBlock.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 8
      margin-right: 8
      height: 24
      font: verdana-11px-antialised
      color: #c0b8d8
      background-color: #1c1930
      border-width: 1
      border-color: #2e2b4a
      @onClick: modules.game_battlepass.onStatusAction()

  HorizontalSeparator
    id: footerSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footer.top
    margin-bottom: 8

  Panel
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 36
    background-color: #1c1930

    Label
      id: finalLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      font: verdana-11px-antialised
      color: #e0b050
      text: FINAL REWARD:

    Label
      id: finalSubLabel
      anchors.left: finalLabel.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-antialised
      color: #6c6488
      text: (only for PRO)

    UIItem
      id: finalItem
      size: 32 32
      anchors.left: finalSubLabel.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      virtual: true

    Label
      id: finalItemName
      anchors.left: finalItem.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-antialised
      color: #a89cc0

    Label
      id: dayCounterLabel
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12
      font: verdana-11px-antialised
      color: #6c6488

    Button
      id: closeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 70
      height: 20
      margin-right: 8
      !text: tr('Close')
      @onClick: modules.game_battlepass.hide()
