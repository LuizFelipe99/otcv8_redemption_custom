BattlePassSectionHeader < UIWidget
  height: 22
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000088
  padding-left: 8
  padding-right: 8

  Label
    id: title
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #f0c060
    text-auto-resize: true
    phantom: true

  Label
    id: detail
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

BattlePassDayCard < UIWidget
  size: 80 78
  background-color: #00000055
  border-width: 1
  border-color: #3a3a3a
  focusable: false
  change-cursor-image: true
  cursor: pointer
  @onClick: modules.game_battlepass.onDayClicked(self)

  $hover:
    background-color: #ffffff12

  Label
    id: dayNumber
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    font: verdana-11px-rounded
    color: #c0c0c0
    text-align: center
    phantom: true

  UIItem
    id: item
    size: 32 32
    anchors.top: dayNumber.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    virtual: true
    phantom: true

  Label
    id: status
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    font: verdana-11px-rounded
    color: #707070
    text-auto-resize: true
    phantom: true

  UIWidget
    id: stateIcon
    anchors.right: status.left
    anchors.verticalCenter: status.verticalCenter
    margin-right: 4
    phantom: true

BattlePassRewardRow < UIWidget
  height: 38
  phantom: true

  UIItem
    id: icon
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/item
    virtual: true

  Label
    id: amount
    anchors.left: icon.right
    anchors.top: icon.top
    margin-left: 8
    margin-top: 3
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: true
    phantom: true

  Label
    id: itemName
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: amount.bottom
    margin-left: 8
    margin-top: 2
    font: verdana-11px-rounded
    color: #a0a0a0
    phantom: true

BattlePassActionButton < Button
  height: 24
  font: Verdana Bold-11px
  color: #ffffff
  text-offset: 0 1

  $hover !disabled:
    color: #f0c060

  $disabled:
    color: #7a7a7a
    opacity: 0.85

BattlePassTrack < UIWidget
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000044
  border-width: 0
  padding: 8

  UIWidget
    id: accent
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 3
    margin-top: -8
    margin-left: -8
    margin-bottom: -8
    phantom: true

  Label
    id: trackTitle
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 4
    font: Verdana Bold-11px
    text-auto-resize: true
    phantom: true

  Label
    id: trackHint
    anchors.verticalCenter: trackTitle.verticalCenter
    anchors.right: parent.right
    font: verdana-11px-rounded
    color: #8a8a8a
    text-auto-resize: true
    phantom: true

  Panel
    id: rewardList
    anchors.top: trackTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: claimButton.top
    margin-top: 8
    margin-left: 4
    margin-bottom: 6
    layout:
      type: grid
      cell-size: 184 38
      cell-spacing: 2
      flow: true

  BattlePassActionButton
    id: claimButton
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

MainWindow
  id: battlePassWindow
  size: 900 610
  @onEscape: modules.game_battlepass.hide()

  UIWidget
    id: titleBanner
    size: 240 80
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -65
    image-source: /images/custom/battle_pass
    image-auto-resize: true
    phantom: true

  UIWidget
    id: headerBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 28
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000088
    padding-left: 10
    padding-right: 10

    Label
      id: seasonLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      font: Verdana Bold-11px
      color: #f0c060
      text-auto-resize: true

    Label
      id: dateLabel
      anchors.left: seasonLabel.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      font: verdana-11px-rounded
      color: #8a8a8a
      text-auto-resize: true

    UIWidget
      id: passBadge
      size: 60 19
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/custom/battle-pass-badge
      phantom: true

      Label
        id: passBadgeLabel
        anchors.centerIn: parent
        margin-top: 1
        font: Verdana Bold-11px
        text-auto-resize: true
        phantom: true

    Label
      id: passHint
      anchors.right: passBadge.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      font: verdana-11px-rounded
      color: #8a8a8a
      text-auto-resize: true

  Panel
    id: progressRow
    anchors.top: headerBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 20
    margin-top: 8

    Label
      id: progressLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      font: verdana-11px-rounded
      color: #9d9d9d
      text: Season progress
      text-auto-resize: true

    Label
      id: dayCounterLabel
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      font: verdana-11px-rounded
      color: #c0c0c0
      text-auto-resize: true

    ProgressBar
      id: progressBar
      anchors.left: progressLabel.right
      anchors.right: dayCounterLabel.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      margin-right: 10
      height: 16
      background-color: #c28400
      on: true

  UIWidget
    id: leftPanel
    anchors.top: progressRow.bottom
    anchors.left: parent.left
    anchors.bottom: footer.top
    width: 448
    margin-top: 10
    margin-bottom: 10
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000044
    padding: 6

    BattlePassSectionHeader
      id: daysHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    ScrollablePanel
      id: dayScrollArea
      anchors.top: daysHeader.bottom
      anchors.left: parent.left
      anchors.right: dayScrollbar.left
      anchors.bottom: missionPanel.top
      margin-top: 6
      margin-bottom: 6
      margin-right: 4
      vertical-scrollbar: dayScrollbar
      layout:
        type: grid
        cell-size: 80 78
        cell-spacing: 4
        flow: true

    VerticalScrollBar
      id: dayScrollbar
      anchors.top: daysHeader.bottom
      anchors.bottom: missionPanel.top
      anchors.right: parent.right
      margin-top: 6
      margin-bottom: 6
      step: 82
      pixel-scroll: true

    UIWidget
      id: missionPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 112
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      background-color: #00000066
      padding: 8

      Label
        id: missionTitle
        anchors.top: parent.top
        anchors.left: parent.left
        font: Verdana Bold-11px
        color: #f0c060
        text-auto-resize: true

      Label
        id: missionDayIndicator
        anchors.top: parent.top
        anchors.right: parent.right
        font: verdana-11px-rounded
        color: #9d9d9d
        text-auto-resize: true

      UIWidget
        id: missionIconFrame
        size: 45 51
        anchors.top: missionTitle.bottom
        anchors.left: parent.left
        margin-top: 6
        image-source: /images/custom/icon-masterylevel-1
        phantom: true

      UIItem
        id: missionItem
        size: 32 32
        anchors.centerIn: missionIconFrame
        margin-bottom: 3
        virtual: true

      Label
        id: missionDesc
        anchors.top: missionIconFrame.top
        anchors.left: missionIconFrame.right
        anchors.right: parent.right
        margin-left: 10
        font: verdana-11px-rounded
        color: #dfdfdf
        text-wrap: true
        text-auto-resize: true

      ProgressBar
        id: missionProgressBar
        anchors.bottom: missionIconFrame.bottom
        anchors.left: missionIconFrame.right
        anchors.right: parent.right
        margin-left: 10
        height: 16
        background-color: #2f9e44
        on: true

  UIWidget
    id: rightPanel
    anchors.top: leftPanel.top
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: leftPanel.bottom
    margin-left: 10
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000044
    padding: 6

    BattlePassSectionHeader
      id: detailHeader
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    BattlePassTrack
      id: proTrack
      anchors.top: detailHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 178
      margin-top: 8

    BattlePassTrack
      id: freeTrack
      anchors.top: proTrack.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 178
      margin-top: 8

    Label
      id: dayStatusLabel
      anchors.top: freeTrack.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      font: verdana-11px-rounded
      color: #9d9d9d
      text-align: center

  UIWidget
    id: footer
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 44

    UIWidget
      id: finalRewardFrame
      size: 220 44
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/custom/moldura_text

      UIItem
        id: finalItem
        size: 32 32
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 12
        virtual: true

      Label
        id: finalItemName
        anchors.left: finalItem.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        margin-right: 10
        font: verdana-11px-rounded
        color: #f0c060

    Label
      id: finalLabel
      anchors.left: finalRewardFrame.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      font: verdana-11px-rounded
      color: #9d9d9d
      text: Final reward - PRO only
      text-auto-resize: true

    BattlePassActionButton
      id: closeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 82
      !text: tr('Close')
      @onClick: modules.game_battlepass.hide()

    BattlePassActionButton
      id: primaryActionButton
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 8
      width: 170
      @onClick: modules.game_battlepass.onStatusAction()
