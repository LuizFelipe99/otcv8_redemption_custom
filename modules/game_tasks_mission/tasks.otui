TaskSummaryBox < UIWidget
  height: 22
  width: 170
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000066
  padding-left: 6
  padding-right: 6

  UIWidget
    id: icon
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /modules/game_tasks_mission/images/taskIconColorless
    image-smooth: true
    phantom: true

  Label
    id: caption
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true
    phantom: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #f0c060
    text-auto-resize: true
    phantom: true

TaskDifficultyTab < UIButton
  height: 26
  image-source: /images/ui/tabbutton_rounded
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  font: verdana-11px-rounded
  color: #a8a8a8
  text-offset: 12 1
  icon-align: left
  icon-offset: 10 0
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-clip: 0 23 22 23
    color: #dfdfdf

  $on:
    image-clip: 0 46 22 23
    color: #f0c060

TaskListRow < UIWidget
  height: 46
  focusable: true
  background-color: #00000033
  border-width: 1
  border-color: #00000000
  padding: 3

  $hover !focus:
    background-color: #ffffff12

  $focus:
    background-color: #c2840026
    border-color: #c28400

  UIWidget
    id: creatureBox
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000066
    clipping: true
    phantom: true

    UICreature
      id: creature
      size: 40 40
      anchors.centerIn: parent
      creature-center: true
      phantom: true

  UIWidget
    id: difficultyBadge
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 2
    margin-top: 1
    phantom: true

  Label
    id: name
    anchors.left: creatureBox.right
    anchors.right: difficultyBadge.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 5
    margin-right: 6
    font: verdana-11px-rounded
    color: #e8e8e8
    text-auto-resize: false
    phantom: true

  Label
    id: state
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 3
    font: verdana-11px-rounded
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

  ProgressBar
    id: progress
    width: 116
    height: 14
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 2
    margin-bottom: 3
    background-color: #c28400
    font: verdana-11px-rounded
    text-offset: 0 1
    phantom: true

TaskSectionHeader < UIWidget
  height: 20
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000088
  padding-left: 6

  UIWidget
    id: icon
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /modules/game_tasks_mission/images/taskIconColorless
    image-smooth: true
    phantom: true

  Label
    id: title
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #f0c060
    text-auto-resize: true
    phantom: true

TaskMonsterRow < UIWidget
  height: 34
  phantom: true

  UIWidget
    id: creatureBox
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    clipping: true
    phantom: true

    UICreature
      id: creature
      size: 34 34
      anchors.centerIn: parent
      creature-center: true
      phantom: true

  Label
    id: name
    anchors.left: creatureBox.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true
    phantom: true

TaskRewardItemRow < UIWidget
  height: 36
  phantom: true

  Item
    id: item
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true

  Label
    id: name
    anchors.left: item.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #6fd38a
    text-auto-resize: true
    phantom: true

TaskActionButton < Button
  width: 82
  height: 22

MainWindow
  id: tasksWindow
  size: 820 560
  text: Tasks

  Panel
    id: summaryBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22

    TaskSummaryBox
      id: activeSummary
      anchors.left: parent.left
      anchors.top: parent.top

    TaskSummaryBox
      id: readySummary
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 6

    TaskSummaryBox
      id: cooldownSummary
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 6

    ComboBox
      id: statusFilterComboBox
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 140

    Label
      id: statusFilterLabel
      anchors.right: statusFilterComboBox.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      font: verdana-11px-rounded
      color: #9d9d9d
      text: Show:
      text-auto-resize: true

  Panel
    id: difficultyTabs
    anchors.top: summaryBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    margin-top: 8
    layout:
      type: horizontalBox
      spacing: 4

    TaskDifficultyTab
      id: tabAll
      width: 194
      @onClick: modules.game_tasks_mission.onDifficultyTabClick('all')

    TaskDifficultyTab
      id: tabEasy
      width: 194
      icon: /modules/game_tasks_mission/images/difficulty_easy
      @onClick: modules.game_tasks_mission.onDifficultyTabClick('easy')

    TaskDifficultyTab
      id: tabMedium
      width: 194
      icon: /modules/game_tasks_mission/images/difficulty_medium
      @onClick: modules.game_tasks_mission.onDifficultyTabClick('medium')

    TaskDifficultyTab
      id: tabHard
      width: 194
      icon: /modules/game_tasks_mission/images/difficulty_hard
      @onClick: modules.game_tasks_mission.onDifficultyTabClick('hard')

  UIWidget
    id: listPanel
    anchors.top: difficultyTabs.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 390
    margin-top: 6
    margin-bottom: 32
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000044
    padding: 4

    TextEdit
      id: search
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 20
      font: verdana-11px-rounded
      placeholder: Search task or monster...

    Panel
      id: listHeader
      anchors.top: search.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 18
      margin-top: 4

      Label
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        font: verdana-11px-rounded
        color: #888888
        text: Task
        text-auto-resize: true

      Label
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 54
        font: verdana-11px-rounded
        color: #888888
        text: Progress
        text-auto-resize: true

    ScrollablePanel
      id: selectionList
      anchors.top: listHeader.bottom
      anchors.left: parent.left
      anchors.right: selectionScroll.left
      anchors.bottom: parent.bottom
      margin-top: 2
      margin-right: 3
      vertical-scrollbar: selectionScroll
      layout:
        type: verticalBox
        spacing: 3

    VerticalScrollBar
      id: selectionScroll
      anchors.top: listHeader.bottom
      margin-top: 2
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      step: 49
      pixel-scroll: true

    Label
      id: emptyListLabel
      anchors.centerIn: selectionList
      font: verdana-11px-rounded
      color: #707070
      text: No tasks match this filter.
      text-auto-resize: true
      visible: false

  UIWidget
    id: detailPanel
    anchors.top: listPanel.top
    anchors.left: listPanel.right
    anchors.right: parent.right
    anchors.bottom: listPanel.bottom
    margin-left: 8
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000044
    padding: 6

    UIWidget
      id: titleBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      background-color: #00000088

      Label
        id: title
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        font: verdana-11px-rounded
        color: #f0c060
        text-auto-resize: true

    UIWidget
      id: creatureBox
      size: 76 76
      anchors.top: titleBar.bottom
      anchors.left: parent.left
      margin-top: 8
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      background-color: #00000066
      clipping: true
      phantom: true

      UICreature
        id: creature
        size: 76 76
        anchors.centerIn: parent
        creature-center: true
        phantom: true

    UIWidget
      id: difficultyBadge
      anchors.top: creatureBox.top
      anchors.left: creatureBox.right
      margin-left: 10
      phantom: true

    Label
      id: name
      anchors.verticalCenter: difficultyBadge.verticalCenter
      anchors.left: difficultyBadge.right
      anchors.right: parent.right
      margin-left: 8
      font: verdana-11px-rounded
      color: #ffffff

    Label
      id: status
      anchors.top: difficultyBadge.bottom
      anchors.left: creatureBox.right
      anchors.right: parent.right
      margin-left: 10
      margin-top: 6
      font: verdana-11px-rounded
      color: #c0c0c0

    ProgressBar
      id: progress
      anchors.bottom: creatureBox.bottom
      anchors.left: creatureBox.right
      anchors.right: parent.right
      margin-left: 10
      height: 18
      background-color: #c28400
      font: verdana-11px-rounded
      text-offset: 0 2

    TaskSectionHeader
      id: monstersHeader
      anchors.top: creatureBox.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    ScrollablePanel
      id: monsterList
      anchors.top: monstersHeader.bottom
      anchors.left: parent.left
      anchors.right: monsterScroll.left
      height: 110
      margin-top: 4
      margin-left: 4
      vertical-scrollbar: monsterScroll
      layout:
        type: grid
        cell-size: 178 34
        cell-spacing: 2
        flow: true

    VerticalScrollBar
      id: monsterScroll
      anchors.top: monstersHeader.bottom
      height: 110
      margin-top: 4
      anchors.right: parent.right
      step: 36
      pixel-scroll: true

    TaskSectionHeader
      id: rewardsHeader
      anchors.top: monsterList.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

    Label
      id: experienceReward
      anchors.top: rewardsHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 6
      font: verdana-11px-rounded
      color: #6fd38a

    Panel
      id: rewardItems
      anchors.top: experienceReward.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-left: 4
      layout:
        type: grid
        cell-size: 178 36
        cell-spacing: 2
        flow: true

    Label
      id: emptyDetailLabel
      anchors.centerIn: parent
      font: verdana-11px-rounded
      color: #707070
      text: Select a task to see its details.
      text-auto-resize: true
      visible: false

  TaskActionButton
    id: startButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    text: Start
    @onClick: modules.game_tasks_mission.start()

  TaskActionButton
    id: finishButton
    anchors.left: prev.right
    anchors.bottom: parent.bottom
    margin-left: 6
    text: Hand In
    @onClick: modules.game_tasks_mission.finish()

  TaskActionButton
    id: abortButton
    anchors.left: prev.right
    anchors.bottom: parent.bottom
    margin-left: 6
    text: Abort
    @onClick: modules.game_tasks_mission.abort()

  TaskActionButton
    id: toggleButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    text: Close
    @onClick: modules.game_tasks_mission.toggleWindow()

  Label
    id: info
    anchors.left: abortButton.right
    anchors.right: toggleButton.left
    anchors.verticalCenter: toggleButton.verticalCenter
    margin-left: 10
    margin-right: 10
    font: verdana-11px-rounded
    text-align: center
