PanelTop < Panel
  text-offset: 0 3
  text-align: top
  padding-left: 7
  padding-bottom: 7
  padding-top: 24
  padding-right: 7

SelectionButton < Panel
  image-source: /images/ui/miniwindow
  image-border: 1
  border-width: 1
  border-color: black
  focusable: true
  phantom: false
  @onDoubleClick: modules.game_tasks_mission.onTaskClick(self)

  $hover:
    border-color: white

  $focus:
    border-color: white

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    text-align: top
    text-wrap: true
    text-border: 5 black

  UICreature
    id: creature
    size: 60 60
    phantom: true
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  Label
    id: reward
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-bottom: 39
    text-wrap: true

  Panel
    id: progressEmpty
    border: 1 black
    margin-left: 3
    margin-right: 3
    margin-bottom: 3
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    size: 0 20

  Panel
    id: progress
    image-source: /images/ui/panel_flat
    image-color: #00ff00
    margin-left: 3
    margin-bottom: 3
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 0 20

  Label
    id: kills
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-bottom: 5
    text-wrap: true

MainWindow
  size: 705 510
  id: tasksWindow
  anchors.verticalCenter: parent.verticalCenter
  anchors.HorizontalCenter: parent.HorizontalCenter
  text: Task
  text-offset: 0 10

  Panel
    id: listSearch
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 21
    margin-left: 15
    margin-right: 15
    margin-top: 17

    ComboBox
      id: difficultyFilterComboBox
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 130

    UITextEdit
      id: search
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: difficultyFilterComboBox.left
      margin-right: 6
      background-color: #1c1c1c
      border-width: 1
      border-color: #3a3a3a
      font: verdana-11px-rounded
      placeholder: Search by name

  FlatPanel
    id: taskListPanel
    anchors.top: listSearch.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 12
    margin-right: 12
    margin-bottom: 38
    padding: 4
    image-source: /images/ui/3pixel_frame_borderimage
    image-border: 3

    ScrollablePanel
      id: selectionList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-right: 14
      vertical-scrollbar: selectionScroll
      layout:
        type: grid
        cell-size: 200 150
        cell-spacing: 12
        flow: true

    VerticalScrollBar
      id: selectionScroll
      anchors.top: selectionList.top
      anchors.bottom: selectionList.bottom
      anchors.right: parent.right
      step: 80
      pixel-scroll: true

  Label
    id: info
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 140
    height: 45
    margin-right: 25
    margin-bottom: 8
    text-align: center
    text-wrap: true

  Button
    id: toggleButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    text: Close
    width: 65
    margin-right: 25
    margin-bottom: 12
    @onClick: modules.game_tasks_mission.toggleWindow()

  Button
    id: finishButton
    anchors.bottom: parent.bottom
    anchors.right: toggleButton.left
    text: Finish
    width: 55
    margin-right: 5
    margin-bottom: 12
    visible: false
    @onClick: modules.game_tasks_mission.finish()

  Button
    id: startButton
    anchors.bottom: parent.bottom
    anchors.right: toggleButton.left
    text: Start
    width: 55
    margin-right: 5
    margin-bottom: 12
    visible: false
    @onClick: modules.game_tasks_mission.start()

  Button
    id: abortButton
    anchors.bottom: parent.bottom
    anchors.right: toggleButton.left
    text: Abort
    width: 55
    margin-right: 5
    margin-bottom: 12
    visible: false
    @onClick: modules.game_tasks_mission.abort()

  PanelTop
    id: detailTab
    anchors.fill: parent
    padding: 20
    visible: false
    background-color: #000000ec

    Label
      id: creatureName
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      font: verdana-11px-rounded
      text-auto-resize: true
      margin-top: 10
      color: #ff8400

    UICreature
      id: creatureImage
      size: 100 100
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10

    Label
      id: detailKills
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      width: 150
      text-align: center

    Label
      id: detailExp
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      color: white

    Label
      id: rewardTitle
      text: "Items:"
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 20
      font: verdana-11px-rounded
      visible: false

    Panel
      id: rewardItems
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      height: 35
      width: 200
      layout:
        type: horizontalBox
        spacing: 5
        align-center: true

    Button
      id: backButton
      text: "Back"
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      width: 80
      margin-bottom: 20
      @onClick: modules.game_tasks_mission.openMainModule()
