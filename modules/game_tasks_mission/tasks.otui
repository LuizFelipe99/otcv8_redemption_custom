PanelTop < Panel
  text-offset: 0 3
  text-align: top
  padding-left: 7
  padding-bottom: 7
  padding-top: 24
  padding-right: 7

SelectionButton < Panel
  image-source: /images/ui/miniwindow
  image-border: 1
  border-width: 1
  border-color: black
  focusable: true
  phantom: false
  @onDoubleClick: modules.game_tasks_mission.onTaskClick(self)

  $hover:
    border-color: white

  $focus:
    border-color: white

  Label
    id: name
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    text-align: top
    text-wrap: true
    text-border: 5 black

  UICreature
    id: creature
    size: 60 60
    phantom: true
    anchors.top: name.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  Label
    id: reward
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    margin-bottom: 39
    text-wrap: true

  Button
    id: detailButton
    size: 44 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 3
    margin-bottom: 3
    font: verdana-11px-antialised
    text: Detail
    @onClick: modules.game_tasks_mission.onTaskClick(self:getParent())

  Panel
    id: progressEmpty
    border: 1 black
    margin-left: 3
    margin-right: 4
    margin-bottom: 3
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: detailButton.left
    size: 0 20

  Panel
    id: progress
    image-source: /images/ui/panel_flat
    image-color: #00ff00
    margin-left: 3
    margin-bottom: 3
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    size: 0 20

  Label
    id: kills
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: detailButton.left
    text-align: center
    margin-bottom: 5
    text-wrap: true

MainWindow
  size: 915 510
  id: tasksWindow
  anchors.verticalCenter: parent.verticalCenter
  anchors.HorizontalCenter: parent.HorizontalCenter
  text: Task
  text-offset: 0 10

  Panel
    id: listSearch
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 21
    margin-left: 15
    margin-right: 15
    margin-top: 17

    ComboBox
      id: difficultyFilterComboBox
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 130

    ComboBox
      id: statusFilterComboBox
      anchors.right: difficultyFilterComboBox.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 120

    UITextEdit
      id: search
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: statusFilterComboBox.left
      margin-right: 6
      background-color: #1c1c1c
      border-width: 1
      border-color: #3a3a3a
      font: verdana-11px-rounded
      placeholder: Search by name

  FlatPanel
    id: taskListPanel
    anchors.top: listSearch.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 12
    margin-right: 12
    margin-bottom: 38
    padding: 4
    image-source: /images/ui/3pixel_frame_borderimage
    image-border: 3

    ScrollablePanel
      id: selectionList
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-right: 14
      vertical-scrollbar: selectionScroll
      layout:
        type: grid
        cell-size: 200 150
        cell-spacing: 12
        flow: true

    VerticalScrollBar
      id: selectionScroll
      anchors.top: selectionList.top
      anchors.bottom: selectionList.bottom
      anchors.right: parent.right
      step: 80
      pixel-scroll: true

  Label
    id: info
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 140
    height: 45
    margin-right: 25
    margin-bottom: 8
    text-align: center
    text-wrap: true

  Button
    id: toggleButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    text: Close
    width: 65
    margin-right: 25
    margin-bottom: 12
    @onClick: modules.game_tasks_mission.toggleWindow()

  Button
    id: finishButton
    anchors.bottom: parent.bottom
    anchors.right: toggleButton.left
    text: Finish
    width: 55
    margin-right: 5
    margin-bottom: 12
    visible: false
    @onClick: modules.game_tasks_mission.finish()

  Button
    id: startButton
    anchors.bottom: parent.bottom
    anchors.right: toggleButton.left
    text: Start
    width: 55
    margin-right: 5
    margin-bottom: 12
    visible: false
    @onClick: modules.game_tasks_mission.start()

  Button
    id: abortButton
    anchors.bottom: parent.bottom
    anchors.right: toggleButton.left
    text: Abort
    width: 55
    margin-right: 5
    margin-bottom: 12
    visible: false
    @onClick: modules.game_tasks_mission.abort()

  PanelTop
    id: detailTab
    anchors.fill: parent
    padding: 20
    visible: false

    Panel
      id: detailScene
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 190
      image-source: /modules/game_tasks_mission/images/battlepass-background_10
      image-fixed-ratio: true
      image-smooth: true

      Label
        id: creatureName
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        font: verdana-11px-rounded
        text-auto-resize: true
        margin-top: 10
        color: #ff8400

      Panel
        id: creatureRow
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        height: 120
        margin-bottom: 6
        layout:
          type: horizontalBox
          spacing: 20
          align-center: true

    Panel
      id: detailInfo
      anchors.top: detailScene.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 10

      Panel
        id: itemsBlock
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        width: 220
        image-source: /images/ui/2pixel_up_frame_borderimage_dark_reversed
        image-border: 2

        Label
          text: "Reward"
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 8
          font: verdana-11px-rounded
          color: #aaaaaa

        Label
          id: rewardTitle
          text: "Items:"
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 30
          font: verdana-11px-rounded
          visible: false

        Panel
          id: rewardItems
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 55
          width: 190
          height: 120
          layout:
            type: grid
            cell-size: 34 34
            cell-spacing: 4
            flow: true

      Panel
        id: statsBlock
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: itemsBlock.left
        margin-right: 10
        image-source: /images/ui/2pixel_up_frame_borderimage_dark_reversed
        image-border: 2

        Label
          text: "Kills"
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 8
          font: verdana-11px-rounded
          color: #aaaaaa

        Label
          id: detailKills
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 30
          width: 150
          text-align: center

        Label
          id: detailExp
          anchors.top: prev.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 5
          color: white

      Panel
        id: statusBlock
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        anchors.left: itemsBlock.right
        margin-left: 10
        image-source: /images/ui/2pixel_up_frame_borderimage_dark_reversed
        image-border: 2

        Label
          text: "About"
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 8
          font: verdana-11px-rounded
          color: #aaaaaa

        Label
          id: detailStatus
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 30
          margin-left: 6
          margin-right: 6
          text-align: center
          text-wrap: true

        Label
          text: "Counts as:"
          anchors.top: prev.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 16
          font: verdana-11px-rounded
          color: #aaaaaa

        Label
          id: detailMonsterNames
          anchors.top: prev.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          margin-left: 6
          margin-right: 6
          text-align: center
          text-wrap: true

      Button
        id: backButton
        text: "Back"
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        width: 80
        margin-bottom: 20
        @onClick: modules.game_tasks_mission.openMainModule()
