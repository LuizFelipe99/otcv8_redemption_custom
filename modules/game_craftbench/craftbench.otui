CraftResourceChip < UIWidget
  size: 74 28
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000077
  padding-left: 3
  padding-right: 6

  UIItem
    id: icon
    size: 24 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true

  Label
    id: amount
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: Verdana Bold-11px
    color: #dfdfdf
    text-align: right
    phantom: true

CraftTab < UIButton
  height: 26
  width: 150
  image-source: /images/ui/tabbutton_rounded
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  font: Verdana Bold-11px
  color: #a8a8a8
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-clip: 0 23 22 23
    color: #dfdfdf

  $on:
    image-clip: 0 46 22 23
    color: #f0c060

CraftToggle < UICheckBox
  height: 20
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000066
  font: verdana-11px-rounded
  color: #9d9d9d
  text-align: center
  change-cursor-image: true
  cursor: pointer

  $hover !checked:
    color: #dfdfdf

  $checked:
    background-color: #c2840044
    color: #ffd27a

CraftRecipeRow < UIWidget
  height: 46
  focusable: true
  background-color: #00000033
  border-width: 1
  border-color: #00000000
  padding: 4
  change-cursor-image: true
  cursor: pointer

  $hover !focus:
    background-color: #ffffff12

  $focus:
    background-color: #c2840026
    border-color: #c28400

  UIItem
    id: icon
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/item
    virtual: true
    phantom: true

  Label
    id: name
    anchors.left: icon.right
    anchors.right: readyLabel.left
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4
    margin-right: 6
    font: verdana-11px-rounded
    color: #e8e8e8
    phantom: true

  Label
    id: subtitle
    anchors.left: name.left
    anchors.right: parent.right
    anchors.top: name.bottom
    margin-top: 3
    font: verdana-11px-rounded
    color: #8a8a8a
    phantom: true

  Label
    id: readyLabel
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 4
    margin-right: 2
    font: verdana-11px-rounded
    text-auto-resize: true
    phantom: true

CraftMaterialRow < UIWidget
  height: 42
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000055
  padding: 3

  UIItem
    id: icon
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/item
    virtual: true

  Label
    id: name
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 4
    margin-right: 4
    font: verdana-11px-rounded
    color: #dfdfdf
    phantom: true

  Label
    id: amount
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 3
    font: Verdana Bold-11px
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

  ProgressBar
    id: ownedBar
    anchors.left: amount.right
    anchors.right: parent.right
    anchors.verticalCenter: amount.verticalCenter
    margin-left: 8
    margin-right: 4
    height: 6
    on: true
    phantom: true

CraftColumnHeader < Label
  height: 18
  font: verdana-11px-rounded
  color: #f0c060
  text-align: left

CraftInfoChip < UIWidget
  height: 26
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000077
  padding-left: 8
  padding-right: 8

  Label
    id: caption
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: Verdana Bold-11px
    text-auto-resize: true
    phantom: true

CraftActionButton < Button
  height: 26
  font: Verdana Bold-11px
  color: #ffffff
  text-offset: 0 1

  $hover !disabled:
    color: #f0c060

  $disabled:
    color: #7a7a7a
    opacity: 0.85

MainWindow
  id: craftBenchWindow
  !text: tr('Craft Bench')
  size: 840 610
  @onEscape: modules.game_craftbench.hide()

  UIWidget
    id: resourceStrip
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 36
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000088
    padding: 4

    CraftResourceChip
      id: goldChip
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 132

    Panel
      id: resourceChips
      anchors.left: goldChip.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 10
      layout:
        type: horizontalBox
        spacing: 4

  Panel
    id: tabBar
    anchors.top: resourceStrip.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    margin-top: 8

    CraftTab
      id: craftTabButton
      anchors.left: parent.left
      anchors.top: parent.top
      !text: tr('Craft')
      @onClick: modules.game_craftbench.switchTab('craft')

    CraftTab
      id: desmancheTabButton
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 4
      !text: tr('Dismantle')
      @onClick: modules.game_craftbench.switchTab('desmanche')

    CraftTab
      id: fusaoTabButton
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 4
      !text: tr('Fusion')
      @onClick: modules.game_craftbench.switchTab('fusao')

  UIWidget
    id: leftPanel
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    width: 310
    margin-top: 6
    margin-bottom: 8
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000044
    padding: 6

    TextEdit
      id: searchInput
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      font: verdana-11px-rounded
      placeholder: Search recipe...
      @onTextChange: modules.game_craftbench.onSearchChange(self:getText())

    ComboBox
      id: categoryFilter
      anchors.top: searchInput.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

    CraftToggle
      id: goldToggle
      anchors.top: categoryFilter.bottom
      anchors.left: parent.left
      width: 96
      margin-top: 6
      !text: tr('Golden')
      @onCheckChange: modules.game_craftbench.setMaterialFilter('gold', self:isChecked())

    CraftToggle
      id: platinumToggle
      anchors.top: goldToggle.top
      anchors.left: prev.right
      width: 96
      margin-left: 4
      !text: tr('Platinum')
      @onCheckChange: modules.game_craftbench.setMaterialFilter('platinum', self:isChecked())

    CraftToggle
      id: readyOnlyToggle
      anchors.top: goldToggle.top
      anchors.left: prev.right
      anchors.right: parent.right
      margin-left: 4
      !text: tr('Ready only')
      @onCheckChange: modules.game_craftbench.setReadyOnlyFilter(self:isChecked())

    Label
      id: listCountLabel
      anchors.top: goldToggle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      font: verdana-11px-rounded
      color: #707070

    ScrollablePanel
      id: recipeRows
      anchors.top: listCountLabel.bottom
      anchors.left: parent.left
      anchors.right: recipeScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-right: 3
      vertical-scrollbar: recipeScrollBar
      layout:
        type: verticalBox
        spacing: 2

    VerticalScrollBar
      id: recipeScrollBar
      anchors.top: listCountLabel.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 4
      step: 48
      pixel-scroll: true

    Label
      id: emptyListLabel
      anchors.centerIn: recipeRows
      font: verdana-11px-rounded
      color: #707070
      text-auto-resize: true
      !text: tr('No recipes match these filters.')
      visible: false

  UIWidget
    id: workbench
    anchors.top: leftPanel.top
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: leftPanel.bottom
    margin-left: 10
    image-source: /images/ui/1pixel-down-frame
    image-border: 1
    background-color: #00000044
    padding: 10

    UIWidget
      id: header
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 46
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      background-color: #00000088
      padding: 5

      UIItem
        id: headerIcon
        size: 36 36
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        image-source: /images/ui/item
        virtual: true

      Label
        id: title
        anchors.left: headerIcon.right
        anchors.right: parent.right
        anchors.top: parent.top
        margin-left: 10
        margin-top: 4
        font: Verdana Bold-11px
        color: #f0c060

      Label
        id: tag
        anchors.left: title.left
        anchors.top: title.bottom
        margin-top: 4
        font: verdana-11px-rounded
        color: #9d9d9d
        text-auto-resize: true

    CraftInfoChip
      id: costChip
      anchors.top: header.bottom
      anchors.left: parent.left
      width: 215
      margin-top: 10

    CraftInfoChip
      id: chanceChip
      anchors.top: costChip.top
      anchors.right: parent.right
      width: 215

    Label
      id: description
      anchors.top: costChip.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      font: verdana-11px-rounded
      color: #a8a8a8
      text-wrap: true
      text-auto-resize: true

    CraftColumnHeader
      id: inputHeader
      anchors.top: description.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    Panel
      id: inputList
      anchors.top: inputHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      layout:
        type: verticalBox
        spacing: 4
        fit-children: true

    CraftColumnHeader
      id: outputHeader
      anchors.top: inputList.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    Panel
      id: outputList
      anchors.top: outputHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      layout:
        type: verticalBox
        spacing: 4
        fit-children: true

    Label
      id: statusBanner
      anchors.left: parent.left
      anchors.right: actionButton.left
      anchors.verticalCenter: actionButton.verticalCenter
      margin-right: 10
      font: verdana-11px-rounded
      text-wrap: true
      text-auto-resize: true

    CraftActionButton
      id: actionButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 150
      @onClick: modules.game_craftbench.performTabAction()

    Label
      id: emptyWorkbenchLabel
      anchors.centerIn: parent
      font: verdana-11px-rounded
      color: #707070
      text-auto-resize: true
      !text: tr('Select a recipe from the list.')
      visible: false

  CraftActionButton
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 90
    !text: tr('Close')
    @onClick: modules.game_craftbench.hide()
