ItemTooltipText < Label
  font: verdana-11px-rounded
  color: #e6e6e6
  text-auto-resize: true
  phantom: true

ItemTooltipBonusText < ItemTooltipText
  color: #6fd38a

ItemTooltipSeparator < UIWidget
  height: 1
  margin-top: 4
  margin-bottom: 4
  background-color: #b8923a55
  phantom: true

ItemTooltipList < UIWidget
  phantom: true
  layout:
    type: verticalBox
    fit-children: true
    spacing: 1

ItemTooltipInfoRow < UIWidget
  phantom: true

  ItemTooltipText
    id: infoLabel
    anchors.top: parent.top
    anchors.left: parent.left
    color: #9a9a9a

  ItemTooltipText
    id: infoValue
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 90
    color: #d8d8d8

ItemTooltipPanel < UIWidget
  width: 300
  background-color: #111111fa
  border-width: 1
  border-color: #b8923a
  padding: 7 9 7 9
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    fit-children: true
    spacing: 1

  UIWidget
    id: header
    height: 34
    phantom: true

    UIItem
      id: itemIcon
      size: 32 32
      anchors.left: parent.left
      anchors.top: parent.top
      image-source: /images/ui/item
      virtual: true
      phantom: true

    ItemTooltipText
      id: itemName
      anchors.left: itemIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      color: #f0c060

    UIWidget
      id: elementIcon
      size: 11 11
      anchors.left: itemIcon.right
      anchors.bottom: itemIcon.bottom
      margin-left: 8
      margin-bottom: 1
      phantom: true
      visible: false

    ItemTooltipText
      id: elementName
      anchors.left: elementIcon.right
      anchors.verticalCenter: elementIcon.verticalCenter
      margin-left: 4
      visible: false

    ItemTooltipText
      id: mainStats
      anchors.left: elementName.right
      anchors.verticalCenter: elementIcon.verticalCenter
      margin-left: 8
      visible: false

  ItemTooltipSeparator
    id: bonusSeparator

  ItemTooltipList
    id: bonusList

  ItemTooltipSeparator
    id: infoSeparator

  ItemTooltipList
    id: infoList

  ItemTooltipSeparator
    id: requirementSeparator

  ItemTooltipText
    id: requirementText
