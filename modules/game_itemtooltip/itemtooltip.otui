ItemTooltipFieldLabel < Label
  font: verdana-11px-rounded
  color: #9a9a9a
  text-auto-resize: true
  phantom: true

ItemTooltipFieldValue < Label
  font: verdana-11px-rounded
  color: #e6e6e6
  text-auto-resize: true
  phantom: true

ItemTooltipFieldRow < UIWidget
  phantom: true
  focusable: false

  ItemTooltipFieldLabel
    id: fieldLabel
    anchors.top: parent.top
    anchors.left: parent.left

  ItemTooltipFieldValue
    id: fieldValue
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 124

ItemTooltipPanel < UIWidget
  width: 320
  background-color: #111111fa
  border-width: 1
  border-color: #b8923a
  padding: 7 8 7 8
  phantom: true
  focusable: false
  layout:
    type: verticalBox
    fit-children: true
    spacing: 2

  UIWidget
    id: header
    height: 34
    phantom: true

    UIItem
      id: itemIcon
      size: 32 32
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/ui/item
      virtual: true
      phantom: true

    Label
      id: itemName
      anchors.left: itemIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 8
      font: verdana-11px-rounded
      color: #f0c060
      text-auto-resize: true
      phantom: true

  UIWidget
    id: separator
    height: 1
    margin-top: 2
    margin-bottom: 3
    background-color: #b8923a66
    phantom: true

  UIWidget
    id: fieldRows
    phantom: true
    layout:
      type: verticalBox
      fit-children: true
      spacing: 1
