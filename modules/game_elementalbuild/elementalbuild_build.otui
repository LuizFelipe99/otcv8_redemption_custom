ElementalBuildPointRow < UIWidget
  height: 52
  margin-bottom: 4
  padding: 8
  background-color: #2e2e2e
  border-width: 1
  border-color: #3a3a3a

  Button
    id: increaseTen
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 2
    margin-right: 2
    width: 30
    height: 18
    font: verdana-11px-antialised
    text: +10
    tooltip: +10 pts | Shift: MAX

  Button
    id: increaseOne
    anchors.right: increaseTen.left
    anchors.top: parent.top
    margin-top: 2
    margin-right: 2
    width: 18
    height: 18
    font: verdana-11px-antialised
    text: +
    tooltip: +1 pt | Shift: MAX

  Label
    id: elementPoints
    anchors.right: increaseOne.left
    anchors.top: parent.top
    margin-top: 4
    margin-right: 4
    width: 60
    font: verdana-11px-antialised
    color: #4a90d9
    text-auto-resize: false
    text-align: center

  Button
    id: decreaseOne
    anchors.right: elementPoints.left
    anchors.top: parent.top
    margin-top: 2
    margin-right: 2
    width: 18
    height: 18
    font: verdana-11px-antialised
    text: -
    tooltip: -1 pt | Shift: MIN

  Button
    id: decreaseTen
    anchors.right: decreaseOne.left
    anchors.top: parent.top
    margin-top: 2
    margin-right: 2
    width: 30
    height: 18
    font: verdana-11px-antialised
    text: -10
    tooltip: -10 pts | Shift: MIN

  Label
    id: elementName
    anchors.left: parent.left
    anchors.right: decreaseTen.left
    anchors.top: parent.top
    margin-top: 4
    margin-right: 4
    font: verdana-11px-antialised
    color: #e0e0e0
    text-auto-resize: false
    text-wrap: false

  Panel
    id: progressBarBg
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 4
    margin-bottom: 4
    background-color: #1a1a1a

    Panel
      id: progressBarFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background-color: #4a90d9

ElementalBuildPointsHeader < UIWidget
  height: 28
  margin-bottom: 6

  Label
    id: availableLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #4a90d9
    text-auto-resize: true
    text: Available: 0

  Label
    id: usedLabel
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #aaaaaa
    text-auto-resize: true
    text: Used: 0

  Label
    id: capLabel
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-antialised
    color: #666666
    text-auto-resize: true
    text: Cap: 500