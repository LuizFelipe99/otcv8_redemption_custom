ElementalOrb < UIWidget
  height: 56
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000077
  padding: 4

  UIWidget
    id: emblem
    size: 18 18
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    phantom: true

  Label
    id: bonus
    anchors.top: emblem.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    font: Verdana Bold-11px
    color: #666666
    text-auto-resize: true
    phantom: true

  Label
    id: elementName
    anchors.top: bonus.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    font: verdana-11px-rounded
    color: #8a8a8a
    text-auto-resize: true
    phantom: true

  UIWidget
    id: fillTrack
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 3
    margin-left: -3
    margin-right: -3
    margin-bottom: -3
    background-color: #00000099
    phantom: true

    UIWidget
      id: fill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      phantom: true

ElementalTab < UIButton
  height: 26
  width: 180
  image-source: /images/ui/tabbutton_rounded
  image-color: #dfdfdf
  image-clip: 0 0 22 23
  image-border: 3
  font: Verdana Bold-11px
  color: #a8a8a8
  text-offset: 0 1
  change-cursor-image: true
  cursor: pointer

  $hover !on:
    image-clip: 0 23 22 23
    color: #dfdfdf

  $on:
    image-clip: 0 46 22 23
    color: #f0c060

ElementalSectionHeader < UIWidget
  height: 22
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000088
  padding-left: 8
  padding-right: 8

  Label
    id: title
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #f0c060
    text-auto-resize: true
    phantom: true

  Label
    id: detail
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

ElementalActionButton < Button
  height: 24
  font: Verdana Bold-11px
  color: #ffffff
  text-offset: 0 1

  $hover !disabled:
    color: #f0c060

  $disabled:
    color: #7a7a7a
    opacity: 0.85

ElementalStepButton < Button
  size: 26 20
  font: Verdana Bold-11px
  color: #ffffff
  text-offset: 0 1

  $hover !disabled:
    color: #f0c060

  $disabled:
    color: #6a6a6a
    opacity: 0.8

JourneyNode < UIWidget
  height: 46
  focusable: true
  background-color: #00000000
  border-width: 1
  border-color: #00000000
  change-cursor-image: true
  cursor: pointer

  $hover !focus:
    background-color: #ffffff10

  $focus:
    background-color: #c2840022
    border-color: #c28400

  UIWidget
    id: lineTop
    anchors.top: parent.top
    anchors.bottom: parent.verticalCenter
    anchors.left: parent.left
    width: 2
    margin-left: 22
    background-color: #3a3a3a
    phantom: true

  UIWidget
    id: lineBottom
    anchors.top: parent.verticalCenter
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 2
    margin-left: 22
    background-color: #3a3a3a
    phantom: true

  UIWidget
    id: node
    size: 30 30
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    image-source: /images/game/wheel/backdrop_skillwheel_socket_inactive
    image-smooth: true
    phantom: true

    Label
      id: nodeNumber
      anchors.centerIn: parent
      font: Verdana Bold-11px
      color: #8a8a8a
      text-auto-resize: true
      phantom: true

    UIWidget
      id: nodeCheck
      size: 12 12
      anchors.centerIn: parent
      image-source: /images/game/wheel/icon-socketed
      visible: false
      phantom: true

  Label
    id: missionName
    anchors.left: node.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 8
    margin-right: 6
    font: verdana-11px-rounded
    color: #e0e0e0
    phantom: true

  Label
    id: missionState
    anchors.left: missionName.left
    anchors.top: missionName.bottom
    margin-top: 3
    font: verdana-11px-rounded
    color: #8a8a8a
    text-auto-resize: true
    phantom: true

RequiredItemRow < UIWidget
  height: 42
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000055
  padding: 4

  UIItem
    id: itemIcon
    size: 34 34
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/item
    virtual: true

  Label
    id: itemName
    anchors.left: itemIcon.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true
    phantom: true

  Label
    id: itemProgress
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 4
    margin-top: 4
    font: verdana-11px-rounded
    text-auto-resize: true
    phantom: true

  ProgressBar
    id: itemProgressBar
    anchors.left: itemIcon.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 4
    margin-bottom: 4
    height: 8
    on: true
    phantom: true

AttunementRow < UIWidget
  height: 50
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000055
  padding: 6

  UIWidget
    id: emblemFrame
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/game/wheel/backdrop_skillwheel_socket_inactive
    image-smooth: true
    phantom: true

    UIWidget
      id: emblem
      size: 18 18
      anchors.centerIn: parent
      phantom: true

  ElementalStepButton
    id: increaseTen
    anchors.right: parent.right
    anchors.top: parent.top
    width: 32
    text: +10

  ElementalStepButton
    id: increaseOne
    anchors.right: increaseTen.left
    anchors.top: parent.top
    margin-right: 3
    text: +

  Label
    id: elementPoints
    anchors.right: increaseOne.left
    anchors.verticalCenter: increaseOne.verticalCenter
    margin-right: 4
    width: 66
    font: verdana-11px-rounded
    color: #dfdfdf
    text-align: center
    phantom: true

  ElementalStepButton
    id: decreaseOne
    anchors.right: elementPoints.left
    anchors.top: parent.top
    margin-right: 4
    text: -

  ElementalStepButton
    id: decreaseTen
    anchors.right: decreaseOne.left
    anchors.top: parent.top
    margin-right: 3
    width: 32
    text: -10

  Label
    id: elementName
    anchors.left: emblemFrame.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 2
    font: Verdana Bold-11px
    text-auto-resize: true
    phantom: true

  Label
    id: bonusPreview
    anchors.left: elementName.right
    anchors.verticalCenter: elementName.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

  Label
    id: elementDescription
    anchors.left: elementName.left
    anchors.right: decreaseTen.left
    anchors.top: elementName.bottom
    margin-top: 3
    margin-right: 8
    font: verdana-11px-rounded
    color: #7d7d7d
    phantom: true

  UIWidget
    id: progressBarBg
    anchors.left: elementName.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 4
    background-color: #00000099
    phantom: true

    UIWidget
      id: progressBarFill
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      phantom: true

PointsSummaryBox < UIWidget
  height: 26
  width: 150
  image-source: /images/ui/1pixel-down-frame
  image-border: 1
  background-color: #00000077
  padding-left: 8
  padding-right: 8

  Label
    id: caption
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #9d9d9d
    text-auto-resize: true
    phantom: true

  Label
    id: value
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: Verdana Bold-11px
    color: #f0c060
    text-auto-resize: true
    phantom: true

MainWindow
  id: elementalBuildWindow
  !text: tr('Elemental Build')
  size: 760 590
  @onEscape: modules.game_elementalbuild.hide()

  Panel
    id: orbBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 56
    layout:
      type: horizontalBox
      spacing: 4

  Panel
    id: tabBar
    anchors.top: orbBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 26
    margin-top: 10

    ElementalTab
      id: missionsTabButton
      anchors.left: parent.left
      anchors.top: parent.top
      text: Missions
      @onClick: modules.game_elementalbuild.switchTab('missions')

    ElementalTab
      id: buildTabButton
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 4
      text: Attunement
      @onClick: modules.game_elementalbuild.switchTab('build')

  Panel
    id: missionsTab
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8

    UIWidget
      id: journeyPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 280
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      background-color: #00000044
      padding: 6

      ElementalSectionHeader
        id: journeyHeader
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right

      ScrollablePanel
        id: missionRows
        anchors.top: journeyHeader.bottom
        anchors.left: parent.left
        anchors.right: missionScrollBar.left
        anchors.bottom: parent.bottom
        margin-top: 6
        margin-right: 3
        vertical-scrollbar: missionScrollBar
        layout:
          type: verticalBox

      VerticalScrollBar
        id: missionScrollBar
        anchors.top: journeyHeader.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 6
        step: 46
        pixel-scroll: true

    UIWidget
      id: missionDetail
      anchors.top: parent.top
      anchors.left: journeyPanel.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10
      image-source: /images/ui/1pixel-down-frame
      image-border: 1
      background-color: #00000044
      padding: 10

      Label
        id: missionTitle
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: missionStatus.left
        margin-right: 8
        font: Verdana Bold-11px
        color: #f0c060

      Label
        id: missionStatus
        anchors.top: parent.top
        anchors.right: parent.right
        font: verdana-11px-rounded
        text-auto-resize: true

      Label
        id: missionDescription
        anchors.top: missionTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        font: verdana-11px-rounded
        color: #c0c0c0
        text-wrap: true
        text-auto-resize: true

      ElementalSectionHeader
        id: itemsHeader
        anchors.top: missionDescription.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 12

      Panel
        id: requiredItems
        anchors.top: itemsHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: rewardLabel.top
        margin-top: 6
        margin-bottom: 8
        layout:
          type: verticalBox
          spacing: 4

      Label
        id: rewardLabel
        anchors.left: parent.left
        anchors.verticalCenter: deliverButton.verticalCenter
        font: verdana-11px-rounded
        color: #6fd38a
        text-auto-resize: true

      ElementalActionButton
        id: deliverButton
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        width: 140
        @onClick: modules.game_elementalbuild.onDeliverMission()

  Panel
    id: buildTab
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    visible: false

    PointsSummaryBox
      id: availableSummary
      anchors.top: parent.top
      anchors.left: parent.left

    PointsSummaryBox
      id: usedSummary
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 6

    PointsSummaryBox
      id: capSummary
      anchors.top: parent.top
      anchors.left: prev.right
      margin-left: 6

    Label
      id: shiftHint
      anchors.right: parent.right
      anchors.verticalCenter: availableSummary.verticalCenter
      font: verdana-11px-rounded
      color: #707070
      text-auto-resize: true
      !text: tr('Shift + click: max / min')

    ScrollablePanel
      id: elementRows
      anchors.top: availableSummary.bottom
      anchors.left: parent.left
      anchors.right: elementScrollBar.left
      anchors.bottom: applyButton.top
      margin-top: 8
      margin-bottom: 8
      margin-right: 3
      vertical-scrollbar: elementScrollBar
      layout:
        type: verticalBox
        spacing: 4

    VerticalScrollBar
      id: elementScrollBar
      anchors.top: availableSummary.bottom
      anchors.bottom: applyButton.top
      anchors.right: parent.right
      margin-top: 8
      margin-bottom: 8
      step: 54
      pixel-scroll: true

    Label
      id: pendingHint
      anchors.left: parent.left
      anchors.verticalCenter: applyButton.verticalCenter
      font: verdana-11px-rounded
      color: #f0c060
      text-auto-resize: true

    ElementalActionButton
      id: applyButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 110
      !text: tr('Apply')
      @onClick: modules.game_elementalbuild.onApply()

    ElementalActionButton
      id: revertButton
      anchors.right: applyButton.left
      anchors.bottom: parent.bottom
      margin-right: 6
      width: 110
      !text: tr('Revert')
      @onClick: modules.game_elementalbuild.onRevert()
